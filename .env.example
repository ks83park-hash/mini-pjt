# 이 파일을 복사해 .env를 만들고 값을 채운다. (.env는 git에 올리지 않는다)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# 기본 모델이 일일 한도 등으로 막히면 순서대로 쓸 예비 모델 (쉼표로 구분, 비워도 됨)
FALLBACK_MODEL_IDS=us.anthropic.claude-haiku-4-5-20251001-v1:0
# 평가 심사(LLM-as-Judge)에 쓸 모델. 비우면 BEDROCK_MODEL_ID와 같은 모델이 심사한다 (자기 답변에 후한 점수를 줄 수 있다)
JUDGE_MODEL_ID=us.anthropic.claude-sonnet-4-6
